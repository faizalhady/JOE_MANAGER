# ─── Database Configuration ───
DB_HOST=your_server_here
DB_PORT=5432
DB_NAME=your_db_name
DB_USER=your_username
DB_PASSWORD=your_password

# ─── Embedding Model Configuration ───
# Model: BAAI/bge-small-en-v1.5 (384 dims) — fast on CPU, great retrieval quality
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# Device auto-detects GPU/CPU. Override here if needed:
# EMBEDDING_DEVICE=cuda
# EMBEDDING_DEVICE=cpu

# BGE models need this prefix on search queries (not on documents).
# Leave empty for non-BGE models like all-mpnet-base-v2.
EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages: 

# ─── Chunking Configuration ───
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ─── Ingestion Settings ───
BATCH_SIZE=32
LOG_LEVEL=INFO
